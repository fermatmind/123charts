# Dedicated file per node/environment; inject via node --env-file or Compose.
NODE_ENV=production
CHARTS_RUNTIME=staging
CHARTS_LOCAL_PREVIEW=false
APP_URL=https://staging.123charts.com
NEXT_PUBLIC_SUPABASE_URL=https://api-staging.123charts.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_123CHARTS_ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_123CHARTS_SERVICE_ROLE_JWT
# Worker inside API Compose uses api-gw; Web uses the API node's private IP.
SUPABASE_INTERNAL_URL=http://api-gw:8000
CHARTS_DATABASE_ORIGIN=http://api-gw:8000
CHARTS_INTERNAL_WEB_URL=http://web:3110
CHARTS_SMTP_HOST=REPLACE_WITH_SMTP_HOST
CHARTS_SMTP_PORT=587
CHARTS_SMTP_SECURE=false
CHARTS_SMTP_USER=REPLACE_WITH_SMTP_USER
CHARTS_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
CHARTS_MAIL_FROM=123Charts <updates@123charts.com>
CHARTS_WORKER_HEALTH_FILE=/tmp/123charts-worker-health
PORT=3110
HOSTNAME=127.0.0.1
