# Copy outside the checkout, chmod 600. Never use FermatMind credentials.
COMPOSE_PROJECT_NAME=123charts-production
API_BIND_IP=127.0.0.1
API_PORT=8010
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRY=3600
ANON_KEY=REPLACE_WITH_HS256_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_HS256_SERVICE_ROLE_JWT
SUPABASE_PUBLIC_URL=https://api.123charts.com
API_EXTERNAL_URL=https://api.123charts.com
SITE_URL=https://123charts.com
ADDITIONAL_REDIRECT_URLS=https://123charts.com/**
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=updates@123charts.com
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_SENDER_NAME=123Charts
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
