{
  "name": "123charts",
  "version": "0.1.0",
  "private": true,
  "description": "123Charts — free project discovery and comparable website charts",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:qa": "next dev -p 3100",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "start:production": "next start",
    "lint": "eslint app components lib scripts/local tests/charts proxy.ts --quiet",
    "typecheck": "tsc --noEmit",
    "runtime:check": "bash deploy/scripts/check-runtime.sh",
    "db:schema:check": "node scripts/check-supabase-migrations.mjs",
    "public-surface:check": "node scripts/check-public-surface-hardening.mjs",
    "intake:check": "node scripts/check-intake-firewall.mjs",
    "external-import:check": "node scripts/check-external-import-integration.mjs",
    "external-import:quarantine:check": "node scripts/check-external-import-quarantine.mjs",
    "external-import:seed-dry-run": "node scripts/check-seed-100-import-dry-run.mjs",
    "geo-checker:check": "node scripts/check-geo-checker.mjs",
    "seed-audit:run": "node scripts/audit-seed-100-readiness.mjs --data-repo ../88cn-index-data --out data/audits/seed-100-readiness --concurrency 2 --timeout 5000 --max-body 262144",
    "seed-audit:check": "node scripts/check-seed-100-readiness-audit.mjs",
    "report:founder-intent:check": "node scripts/check-founder-intent-report.mjs",
    "editorial-draft:check": "node scripts/check-editorial-draft-pipeline.mjs",
    "editorial-copy:check": "node scripts/check-editorial-copy-guard.mjs",
    "brand-voice:check": "node scripts/check-brand-voice.mjs",
    "scouted-profile:check": "node scripts/check-scouted-profile-engine.mjs",
    "conversion-metrics:check": "node scripts/check-conversion-metrics.mjs",
    "submission-channels:check": "node scripts/check-submission-channels-page.mjs",
    "founder-onboarding:check": "node scripts/check-founder-onboarding-copy.mjs",
    "featured-signals:check": "node scripts/check-featured-signals-boundary.mjs",
    "ad-payment-boundary:check": "node scripts/check-ad-payment-boundary.mjs",
    "ad-payment:check": "npm run ad-payment-boundary:check",
    "lifecycle-archive:check": "node scripts/check-lifecycle-archive.mjs",
    "changelog-engine:check": "node scripts/check-changelog-engine.mjs",
    "backers-landing:check": "node scripts/check-backers-landing-boundary.mjs",
    "oss-maintainer:check": "node scripts/oss/check-maintainer-automation.mjs",
    "public-api-boundary:check": "node scripts/check-public-api-boundary.mjs",
    "public-api:v0:check": "node scripts/check-public-api-v0.mjs",
    "mcp-threat-model:check": "node scripts/check-mcp-threat-model.mjs",
    "read-only-mcp:check": "node scripts/check-read-only-mcp-server.mjs",
    "sitemap-notification:check": "node scripts/check-sitemap-notification-boundary.mjs",
    "landscape:check": "node scripts/check-landscape-boundary.mjs",
    "report-distribution-pack:generate": "node scripts/generate-report-distribution-pack.mjs",
    "agent:gate": "bash scripts/agent/gate.sh",
    "agent:smoke:local": "bash scripts/agent/smoke-local.sh",
    "agent:smoke:live": "bash scripts/agent/smoke-live.sh",
    "agent:deploy:prepare": "node scripts/agent/prepare-live-deploy.mjs",
    "agent:deploy:production": "bash scripts/agent/deploy-production.sh",
    "agent:redact:check": "node scripts/agent/redact-check.mjs",
    "agent:scope:check": "node scripts/agent/scope-check.mjs",
    "agent:triage:check": "node scripts/agent/triage-check.mjs",
    "agent:cache-contract:check": "node scripts/agent/cache-contract-check.mjs",
    "agent:telemetry-contract:check": "node scripts/agent/telemetry-contract-check.mjs",
    "agent:event-contract:check": "node scripts/agent/event-contract-check.mjs",
    "agent:tool:check": "node scripts/agent/tool-check.mjs",
    "agent:mcp-config:check": "node scripts/agent/mcp-config-check.mjs",
    "agent:plugin-policy:check": "node scripts/agent/plugin-policy-check.mjs",
    "agent:batch:check": "node scripts/agent/batch-check.mjs",
    "agent:train-plan:check": "node scripts/agent/train-plan-check.mjs",
    "agent:gate-coverage:check": "node scripts/agent/gate-coverage-check.mjs",
    "agent:pr:summary": "node scripts/agent/pr-summary.mjs",
    "docs:check": "node -e \"const fs=require('fs'); const files=['AGENTS.md','README.md','.gitignore','package.json','docs/00_PROJECT_BRIEF.md','docs/01_AGENT_OPERATING_MODEL.md','docs/02_ZERO_STATE_BOOTSTRAP.md','docs/06_FORBIDDEN_PATTERNS.md','docs/07_RUNTIME_GUARDS.md','docs/08_BATCH_PIPELINE.md','docs/09_EDITORIAL_PIPELINE.md','docs/10_DATA_CONTRACT.md','docs/DAY0_AUDIT.md','docs/11_SCALABILITY_GUARDS.md','docs/12_CACHE_AND_SITEMAP_STRATEGY.md','docs/13_COST_GUARDS.md','docs/14_OPEN_SOURCE_REUSE_POLICY.md','docs/RISK_ACCEPTANCE_LOG.md','docs/TASK_STATUS.md','docs/QA_REPORT.md','docs/VISUAL_BUGS.md','docs/FLOW_BUGS.md','docs/BUILD_ERRORS.md','third_party/NOTICE.md','screenshots/qa/.gitkeep','scripts/scan-forbidden-patterns.mjs','scripts/check-third-party-notices.mjs','scripts/codex-preflight.sh']; const missing=files.filter((file)=>!fs.existsSync(file)); if (missing.length) { console.error('Missing required files:\\n'+missing.join('\\n')); process.exit(1); } console.log('docs:check passed');\"",
    "policy:scan": "node scripts/scan-forbidden-patterns.mjs",
    "third-party:check": "node scripts/check-third-party-notices.mjs",
    "verify:day0": "npm run docs:check && npm run policy:scan && npm run third-party:check",
    "local:setup": "node scripts/local/setup.mjs",
    "dev:local": "node scripts/local/dev.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "worker:local": "tsx scripts/local/worker.ts",
    "test:charts": "tsx --test tests/charts/*.test.ts",
    "test:browser": "playwright test tests/charts/browser.spec.ts tests/charts/navigation.spec.ts",
    "db:types": "supabase gen types typescript --local > lib/charts/database.types.ts",
    "format:check": "prettier --check components/charts lib/charts scripts/local tests/charts proxy.ts",
    "test:db:charts": "bash scripts/local/test-db.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "tldts": "^7.4.19",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
